# Optional: enables FRED/ALFRED. The offline demo does not need it.
FRED_API_KEY=

# SEC asks for a descriptive contact. Replace with your own before bulk work.
DOMINO_USER_AGENT=Domino-Agent research your-email@example.com

# Optional: licensed Loughran-McDonald master dictionary CSV.
DOMINO_LM_DICTIONARY=

# Comma-separated allowed origins for the local dashboard.
DOMINO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
